{
  "name": "@rxova/planner-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The planner behind jev-planner: agents that draft and cross-review coding plans, a judge that routes the run, and the CLI around them.",
  "keywords": [
    "planning",
    "implementation-plan",
    "codex",
    "claude",
    "claude-code",
    "ai-agents",
    "llm"
  ],
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:exports": "rxova-repo-config check-exports",
    "pack:smoke": "rxova-repo-config pack-smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/jev-planner.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rxova/jev-planner/issues"
  },
  "homepage": "https://jev-planner.com"
}
