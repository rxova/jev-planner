{
  "name": "@rxova/example",
  "version": "0.0.0",
  "description": "A placeholder package: rename it, or copy it for each new package.",
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/template-oss.git",
    "directory": "packages/example"
  },
  "homepage": "https://github.com/rxova/template-oss#readme",
  "bugs": "https://github.com/rxova/template-oss/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack . --profile esm-only",
    "pack:smoke": "node --import tsx ../tooling/pack-smoke.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/config": "workspace:*",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
