{
  "name": "jev-planner-workspace",
  "private": true,
  "description": "The workspace around the jev-planner CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/jev-planner.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run eslint:check",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "eslint:check": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "turbo run prettier:check",
    "prettier:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "audit:check": "pnpm audit --audit-level=high --ignore-registry-errors",
    "dedupe:check": "pnpm dedupe --check",
    "sherif:check": "sherif --fail-on-warnings",
    "knip:check": "knip",
    "check:exports": "turbo run check:exports",
    "pack:smoke": "turbo run pack:smoke",
    "check:llms": "rxova-repo-config check-llms",
    "changeset": "changeset",
    "release": "turbo run build --filter=jev-planner && changeset publish",
    "verify": "rxova-repo-config verify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rxova/repo-config": "^0.5.0",
    "@rxova/ts-utils": "^0.2.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "sherif": "^1.13.0",
    "turbo": "^2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "repoConfig": {
    "verify": {
      "steps": [
        {
          "name": "dependency versions",
          "command": "pnpm run sherif:check"
        },
        {
          "name": "unused files, exports and dependencies",
          "command": "pnpm run knip:check"
        },
        {
          "name": "dependency dedupe",
          "command": "pnpm exec turbo run //#dedupe:check"
        },
        {
          "name": "format",
          "command": "pnpm run format:check"
        },
        {
          "name": "lint",
          "command": "pnpm run lint"
        },
        {
          "name": "llms.txt",
          "command": "pnpm run check:llms"
        },
        {
          "name": "typecheck",
          "command": "pnpm exec turbo run typecheck"
        },
        {
          "name": "unit tests",
          "command": "pnpm exec turbo run test"
        },
        {
          "name": "build",
          "command": "pnpm exec turbo run build --filter='!@repo/docs'"
        },
        {
          "name": "package exports",
          "command": "pnpm run check:exports"
        }
      ]
    }
  }
}
