{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      // Tests and prose cannot change dist, so editing them should not cost a
      // rebuild. The shared preset is named explicitly: @repo/config has no
      // build task, so nothing in `dependsOn` would carry a change to it.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/tsdown.base.ts",
        "!**/__tests__/**",
        "!**/*.test.*",
        "!README.md"
      ],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // Keyed on the shared preset for the same reason as build: a raised
    // threshold has to re-run every suite, not replay yesterday's pass.
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/vitest.base.ts"],
      "outputLogs": "new-only"
    },
    // publint and attw read the built artifacts, so never a stale dist.
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // Never cached: a replayed pass says nothing about what npm would serve.
    "pack:smoke": {
      "dependsOn": ["build"],
      "cache": false,
      "outputLogs": "new-only"
    },
    // Root tasks (`//#`): each reads the whole tree in one pass, so there is
    // nothing to fan out, but caching them makes an unchanged tree free — and
    // with the remote cache in CI, free on the runner too.
    "//#eslint:check": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.{md,mdx,css,svg,png,jpg,jpeg,webp,txt}", "!LICENSE"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#prettier:check": {
      "inputs": ["$TURBO_DEFAULT$", "!pnpm-lock.yaml", "!**/CHANGELOG.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // Keyed on exactly the files that feed it. audit:check is deliberately not a
    // task: its verdict changes with the advisory database, not with this tree.
    "//#dedupe:check": {
      "inputs": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        "packages/*/package.json",
        "apps/*/package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
