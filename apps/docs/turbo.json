{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      // version.json carries the jev-planner version, which lives outside this
      // package: without this, the release's version bump would replay the
      // previous build and deploy a marker that names the old release.
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/jev-planner/package.json"],
      // These decide the mount and therefore every emitted URL, so they belong
      // in the cache key: without them a local sub-path build could replay for
      // the production build in CI, and nothing would notice until
      // jev-planner.com served it.
      //
      // Declared here rather than on the root task so that setting them does not
      // also invalidate the package build, which never reads them.
      //
      // DOCS_COMMIT is written into version.json, and DOCS_RELEASE_VERSION can
      // fail the build, so both are part of what a cached build means too.
      "env": ["DOCS_URL", "DOCS_BASE_URL", "DOCS_COMMIT", "DOCS_RELEASE_VERSION"],
      "outputLogs": "new-only"
    },
    // No `^build` and no coverage: every module under test is plain JavaScript
    // over plain objects, which is the whole reason they are split out from the
    // Astro-only adapter beside them.
    "test": {
      "dependsOn": [],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // This app publishes no tarball and has neither of these scripts, but both
    // root tasks declare `dependsOn: ["build"]` — which applies here too and
    // pulls a full Astro build into `pnpm run check:exports` and
    // `pnpm run pack:smoke`. Overriding them to nothing keeps the
    // package-contract job from rendering a site it will not look at.
    "check:exports": {
      "dependsOn": [],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "pack:smoke": {
      "dependsOn": [],
      "outputs": [],
      "outputLogs": "new-only"
    }
  }
}
