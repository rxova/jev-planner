{
  "name": "@repo/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The jev-planner landing page and documentation, deployed to GitHub Pages at jev-planner.com.",
  "scripts": {
    "dev": "astro dev",
    "sync": "astro sync",
    "build": "astro build && rxova-docs-kit check-md-routes && node ./scripts/check-site-build.mjs",
    "og": "node ./scripts/make-og.mjs",
    "preview": "astro preview",
    "serve:dist": "node ./e2e/serve.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/space-grotesk": "5.3.0",
    "@rxova/astro-ui": "0.7.0",
    "@rxova/brand": "1.4.0",
    "astro": "^7.4.2",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "github-slugger": "^2.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.23.3"
  }
}
