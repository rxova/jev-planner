---
/**
 * The example run: a static transcript, revealed a line at a time. It opens
 * the landing page (overrides/Hero.astro), above the title, because it tells
 * the whole story before a word of prose does.
 *
 * The whole transcript is real text in the DOM from the first byte; the reveal
 * is CSS `animation-delay` only, plays once, and is skipped entirely under
 * `prefers-reduced-motion`. No script, no loop, no blinking cursor.
 *
 * The stage lines are the point of the block: they name the sequence a reader
 * is here to learn, so they are larger, lit and ruled, and the output sits under
 * them as evidence.
 */
import { TRANSCRIPT } from './content.mjs'
---

<section class="terminal not-content" aria-label="An example run, stage by stage">
  <div class="window">
    <div class="bar" aria-hidden="true"><span></span><span></span><span></span></div>
    <pre tabindex="0"><code>{
      TRANSCRIPT.map(({ kind, text }, i) => (
        <span class:list={['line', kind]} style={`--i: ${String(i)}`}>{text}</span>
      ))
    }</code></pre>
  </div>
</section>

<style>
  .terminal {
    max-width: 56rem;
    margin: 0 auto;
  }
  .window {
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius);
    background: var(--rx-card);
    overflow: hidden;
  }
  .bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rx-rule);
  }
  .bar span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--rx-rule-strong);
  }
  pre {
    margin: 0;
    padding: 1.25rem 1.5rem 1.5rem;
    overflow-x: auto;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-base);
    line-height: 1.8;
    color: var(--rx-muted);
  }
  /* Every line wraps, hanging under its own first line, so no width hides the
     end of one off the right edge or scrolls the page sideways. */
  .line {
    display: block;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: 1.25rem;
    text-indent: -1.25rem;
  }
  .command {
    color: var(--rx-fg);
  }
  .command::before {
    content: '$ ' / '';
    color: var(--rx-primary);
  }
  .stage {
    margin-block-start: 1rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--rx-primary);
    color: var(--rx-fg);
    font-family: var(--sl-font);
    font-weight: 600;
    /* A stage label is a sentence behind its own rule: no hanging indent. */
    text-indent: 0;
  }
  .note {
    color: var(--rx-muted);
    font-style: italic;
  }

  @media (max-width: 30rem) {
    pre {
      font-size: var(--sl-text-sm);
      padding: 1rem 1.25rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .line {
      opacity: 0;
      animation: reveal 0.35s ease-out forwards;
      /* The block is taller than it was, so it is the likeliest LCP element:
         the last line lands near 2.5 s rather than 4.5 s. Opacity and transform
         only, so nothing reflows as it plays. */
      animation-delay: calc(var(--i) * 0.2s + 0.3s);
    }
    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(0.25rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
