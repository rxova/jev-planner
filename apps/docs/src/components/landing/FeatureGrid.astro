---
/**
 * The four stages as numbered cards, each linking to the section of
 * `learn/how-it-works` that explains it.
 *
 * An ordered list, and the number inside the link text, because the order is the
 * content here: a screen reader that announces four unnumbered links in any
 * order has lost the one thing these cards teach.
 */
import { withBase } from '../../lib/base-url.mjs'
import { STAGES } from './content.mjs'

const base = import.meta.env.BASE_URL
---

<section class="features not-content" aria-labelledby="features">
  <h2 id="features">The four stages, in detail</h2>
  <ol>
    {
      STAGES.map(({ n, label, what, href, optional }) => (
        <li class:list={[optional && 'optional']}>
          <h3>
            <a href={withBase(href, base)}>
              <span class="n">{n}</span>
              {label}
            </a>
          </h3>
          <p>{what}</p>
          {optional && <p class="when">Only when Jev asks for it.</p>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .features {
    max-width: 67.5rem;
    margin: 4rem auto 1rem;
  }
  h2 {
    margin-bottom: 1.5rem;
    font-size: var(--sl-text-2xl);
    text-align: center;
    color: var(--rx-fg);
  }
  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius);
    background: var(--rx-card);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  /* The same dashed edge the diagrams give an optional box (theme.css). */
  li.optional {
    border-style: dashed;
  }
  li:hover,
  li:focus-within {
    border-color: var(--rx-primary);
    box-shadow: var(--rx-shadow-soft);
  }
  h3 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-lg);
  }
  .n {
    color: var(--rx-primary);
    font-variant-numeric: tabular-nums;
  }
  a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--rx-fg);
    text-decoration: none;
  }
  /* The whole card is the link's hit area; the link text stays the title. */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  p {
    margin: 0;
    color: var(--rx-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .when {
    margin-top: 0.5rem;
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    li {
      transition: none;
    }
  }
</style>
